{% set lang = page.url | pageLang %}
<nav class="shop-page-filters" aria-label="{{ i18n[lang].shopFilterBarAria }}" data-shop-filter-bar>
  <div class="shop-page-filters__inner">
    <details class="shop-page-filter-menu" data-shop-filter-menu="category">
      <summary class="shop-page-filter">
        {{ i18n[lang].shopFilterCategory }}
        <img class="shop-page-filter__arrow" src="/assets/images/recipe-filter-arrow.svg" alt="" aria-hidden="true" />
      </summary>
      <div class="shop-page-filter-menu__list">
        {% for item in shopFilters.categories %}
        {% set itemLabel = item.labelEs if lang == 'es' else (item.labelEn if lang == 'en' else item.label) %}
        <a
          href="{% if lang == 'es' %}/es/shop/products/catalog/{% elif lang == 'en' %}/en/shop/products/catalog/{% else %}/shop/products/catalog/{% endif %}?category={{ item.value }}"
          class="shop-page-filter-menu__item"
          data-shop-filter-link
          data-shop-filter-type="category"
          data-shop-filter-value="{{ item.value }}"
          data-shop-filter-label="{{ itemLabel }}"
        >{{ itemLabel }}</a>
        {% endfor %}
      </div>
    </details>

    <details class="shop-page-filter-menu" data-shop-filter-menu="moment">
      <summary class="shop-page-filter">
        {{ i18n[lang].shopFilterMoment }}
        <img class="shop-page-filter__arrow" src="/assets/images/recipe-filter-arrow.svg" alt="" aria-hidden="true" />
      </summary>
      <div class="shop-page-filter-menu__list">
        {% for item in shopFilters.moments %}
        {% set itemLabel = item.labelEs if lang == 'es' else (item.labelEn if lang == 'en' else item.label) %}
        <a
          href="{% if lang == 'es' %}/es/shop/products/catalog/{% elif lang == 'en' %}/en/shop/products/catalog/{% else %}/shop/products/catalog/{% endif %}?moment={{ item.value }}"
          class="shop-page-filter-menu__item"
          data-shop-filter-link
          data-shop-filter-type="moment"
          data-shop-filter-value="{{ item.value }}"
          data-shop-filter-label="{{ itemLabel }}"
        >{{ itemLabel }}</a>
        {% endfor %}
      </div>
    </details>

    <details class="shop-page-filter-menu" data-shop-filter-menu="diet">
      <summary class="shop-page-filter">
        {{ i18n[lang].shopFilterDiet }}
        <img class="shop-page-filter__arrow" src="/assets/images/recipe-filter-arrow.svg" alt="" aria-hidden="true" />
      </summary>
      <div class="shop-page-filter-menu__list">
        {% for item in shopFilters.diets %}
        {% set itemLabel = item.labelEs if lang == 'es' else (item.labelEn if lang == 'en' else item.label) %}
        <a
          href="{% if lang == 'es' %}/es/shop/products/catalog/{% elif lang == 'en' %}/en/shop/products/catalog/{% else %}/shop/products/catalog/{% endif %}?diet={{ item.value }}"
          class="shop-page-filter-menu__item"
          data-shop-filter-link
          data-shop-filter-type="diet"
          data-shop-filter-value="{{ item.value }}"
          data-shop-filter-label="{{ itemLabel }}"
        >{{ itemLabel }}</a>
        {% endfor %}
      </div>
    </details>

    <a href="{% if lang == 'es' %}/es/gastronomic/receptes{% elif lang == 'en' %}/en/gastronomic/receptes{% else %}/gastronomic/receptes{% endif %}" class="shop-page-filter">{{ i18n[lang].shopFilterTrees }}</a>
    <div class="shop-page-search-wrap" data-recipe-search data-search-empty="{{ i18n[lang].shopSearchEmpty }}">
      <button type="button" class="shop-page-search" data-recipe-search-toggle>
        {{ i18n[lang].shopFilterSearch }}
        <span aria-hidden="true">&rsaquo;</span>
      </button>
      <input
        type="search"
        class="shop-page-search-input"
        name="q"
        placeholder="{{ i18n[lang].shopSearchPlaceholder }}"
        autocomplete="off"
        data-recipe-search-input
        hidden
      />
      <div class="shop-page-search-results" data-recipe-search-results hidden></div>
    </div>
  </div>
</nav>
{% set searchProducts = collections.products | filterByLang(lang) %}
<script type="application/json" data-recipe-search-data>[
  {% for product in searchProducts %}
  {"title": {{ product.data.title | dump | safe }}, "url": {{ product.url | dump | safe }}}{% if not loop.last %},{% endif %}
  {% endfor %}
]</script>
